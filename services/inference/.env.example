# Laptop (no GPU): mock + CPU
# RACE = private RMIT AWS GPU workstation: real + cuda + job worker
RUN_MODE=mock
DEVICE=cpu

# Layout detector — GreenMap yolo11x-blueprint-layout-detector
# https://huggingface.co/GreenMap/yolo11x-blueprint-layout-detector
# Prefetch: .venv\Scripts\python.exe scripts/prefetch_layout.py
USE_LAYOUT_DETECTOR=false
YOLO_WEIGHTS=https://huggingface.co/GreenMap/yolo11x-blueprint-layout-detector/resolve/main/yolo_layout.pt
YOLO_CONF=0.25
YOLO_IMGSZ=1472

# Stage 2: walls/fixtures tiled inside the layout drawing crop only (full-page fallback is single-pass).
# WALL_BACKEND: mitunet | yolo | cascade_swin | faster_rcnn | retinanet | deeplab | floordata
# Default is MitUNet (Mix-Transformer B4 + U-Net) pixel-accurate wall masks.
# https://github.com/aliasstudio/mitunet
WALL_BACKEND=mitunet
MITUNET_WALL_WEIGHTS=https://media.githubusercontent.com/media/aliasstudio/mitunet/master/experiments/models/mitunet_finetune_a6_mit_b4_tversky_8864_28E.pth
MITUNET_WALL_THRESHOLD=0.5
MITUNET_WALL_IMGSZ=512

# Legacy MMDet wall detectors (download .pth from Google Drive into models/)
# https://drive.google.com/drive/folders/1MgW3Qo-8K4OrHi4ebvYd-81cTqQxwLgz
# Then set WALL_BACKEND=cascade_swin (or faster_rcnn / retinanet)
WALL_CASCADE_SWIN_WEIGHTS=models/cascade_swin_latest.pth
WALL_FASTER_RCNN_WEIGHTS=models/faster_rcnn_latest.pth
WALL_RETINANET_WEIGHTS=models/retinanet_latest.pth

# floorData — TensorFlow DeepLabV3+ / UNet wall segmentation (.h5)
# https://github.com/Divak-ar/floorData — train locally, then copy into models/
# Main inference venv may be Python 3.14 (no TF wheels). Use the dedicated TF venv:
#   py -3.11 -m venv .venv-tf
#   .venv-tf\Scripts\python.exe -m pip install -r requirements-tensorflow.txt
# Studio train + Detect (wall:deeplab / wall:unet_floordata) use that interpreter.
# Optional override (defaults to services/inference/.venv-tf/Scripts/python.exe):
# TENSORFLOW_PYTHON=C:\path\to\.venv-tf\Scripts\python.exe
# WALL_BACKEND=deeplab   or   WALL_BACKEND=unet_floordata
FLOORDATA_DEEPLAB_WEIGHTS=models/deeplab_walls_best.h5
FLOORDATA_UNET_WEIGHTS=models/unet_walls_best.h5
FLOORDATA_WALL_THRESHOLD=0.5
FLOORDATA_WALL_IMGSZ=512

# Large-page inference: overlapping tiles (Studio Infer + wall detect)
DETECT_TILE_ENABLED=true
DETECT_TILE_SIZE=640
DETECT_TILE_OVERLAP=0.2
DETECT_TILE_MIN_SIDE=1280
DETECT_TILE_IOU=0.45

# Train-time overlapping crops (LabelMe Studio datasets)
TRAIN_TILE_ENABLED=true
TRAIN_TILE_SIZE=640
TRAIN_TILE_OVERLAP=0.2
TRAIN_TILE_MIN_SIDE=1280
TRAIN_KEEP_FULL_PAGE_FRAC=0.15

# Sheet-level context (heuristic by default; optional HTTP VLM or local PaddleOCR)
VLM_ENABLED=false
VLM_PROVIDER=heuristic
# Local PaddleOCR (Python 3.10–3.12 — dedicated .venv-ocr recommended):
#   py -3.11 -m venv .venv-ocr
#   .venv-ocr\Scripts\python.exe -m pip install -r requirements-paddle.txt
# PADDLE_OCR_ENABLED=true
# VLM_PROVIDER=paddleocr
# PADDLE_OCR_LANG=en
# PADDLE_OCR_USE_GPU=false
# PADDLE_OCR_PYTHON=C:\path\to\.venv-ocr\Scripts\python.exe
# classic = PP-OCR det+rec (requirements-paddle.txt)
# vl = PaddleOCR-VL 0.9B VLM (requirements-paddle-vl.txt) https://huggingface.co/PaddlePaddle/PaddleOCR-VL
# PADDLE_OCR_BACKEND=classic
# paddleocr 3.7 defaults to v1.6 (PP-DocLayoutV3). The HF PaddleOCR-VL snapshot
# ships PP-DocLayoutV2 — keep v1, or the worker errors "expected PP-DocLayoutV3".
# PADDLE_OCR_VL_PIPELINE_VERSION=v1
# PADDLE_OCR_VL_MAX_SIDE=2048
# Download once: .venv-ocr\Scripts\python.exe scripts/download_paddleocr_vl.py
# PADDLE_OCR_VL_REC_MODEL_DIR=C:\path\to\services\inference\models\paddleocr-vl
# PADDLE_OCR_VL_LAYOUT_MODEL_DIR=C:\path\to\services\inference\models\paddleocr-vl\PP-DocLayoutV2
# Title block OCR (default): max detection side 960px
# PADDLE_OCR_DET_LIMIT_SIDE_LEN=960
# PaddleOCR default detector input is 960px (det_limit_type=max — downscales large images, does not upscale small ones).
# Tile like YOLO infer/train: overlapping windows at 960 so small labels are not lost.
# Crops smaller than 960 are upsampled to 960 before OCR.
# PADDLE_OCR_TILE_ENABLED=true
# PADDLE_OCR_TILE_SIZE=960
# PADDLE_OCR_TILE_OVERLAP=0.25
# PADDLE_OCR_TILE_MIN_SIDE=960
# Drawing-area OCR (small room labels): optional higher per-tile det limit
# PADDLE_OCR_DENSE_DET_LIMIT_SIDE_LEN=960
# PADDLE_OCR_DENSE_DB_THRESH=0.25
# PADDLE_OCR_MAX_LINES=500
# VLM_PROVIDER=http
# VLM_API_URL=https://api.openai.com/v1/chat/completions
# VLM_API_KEY=
# VLM_MODEL=gpt-4o-mini

# Design-policy pack (default: configs/policies/highlife_v1.yaml)
# POLICY_PACK_PATH=

# Fallback oriented-box wall detector (used when WALL_BACKEND=yolo)
# https://huggingface.co/GreenMap/yolo11x-blueprint-wall-detector
YOLO_WALL_WEIGHTS=https://huggingface.co/GreenMap/yolo11x-blueprint-wall-detector/resolve/main/yolo_walls_obb.pt
YOLO_WALL_CONF=0.25
YOLO_WALL_IMGSZ=896

# Architect FloorPlanCAD symbols are off until you supply weights.
# USE_ROOM_DETECTOR=true
# YOLO_ROOM_WEIGHTS=models/your_fixtures.pt
USE_ROOM_DETECTOR=false
YOLO_ROOM_WEIGHTS=
YOLO_ROOM_CONF=0.25
YOLO_ROOM_IMGSZ=640
YOLO_CROP_PAD=0.02

# Crop-stage floor-plan model (Universe: floor-r1kta/floorplan-iculh)
# https://universe.roboflow.com/floor-r1kta/floorplan-iculh
# Prefetch local ONNX once (Python 3.10–3.12): .venv-tf\Scripts\python.exe scripts/prefetch_roboflow.py
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=floorplan-iculh/1
ROBOFLOW_CONF=0.25
# Optional override after prefetch (default: models/roboflow_cache/floorplan-iculh/1/weights.onnx)
# ROBOFLOW_WEIGHTS=models/roboflow_cache/floorplan-iculh/1/weights.onnx

# Local/debug FastAPI bind (not a public RACE endpoint)
API_HOST=127.0.0.1
API_PORT=8000

# Shared AWS data plane. Service role — on the RACE station / worker only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SOFTWARE_COMMIT=
POLICY_VERSION=draft-v1
DATASET_VERSION=v1
