# ── Frontend (apps/web) — laptop, no GPU ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://evpryuayxqnqawyblbhm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local-first floor-plan intelligence API (services/api). Not a cloud vision URL.
NEXT_PUBLIC_FLOOR_PLAN_API_URL=http://127.0.0.1:8001

# Local Inference API. Layout detector is off until you set USE_LAYOUT_DETECTOR.
NEXT_PUBLIC_INFERENCE_API_URL=http://127.0.0.1:8000
USE_LAYOUT_DETECTOR=false
YOLO_WEIGHTS=
USE_ROOM_DETECTOR=false
YOLO_ROOM_WEIGHTS=
# WALL_BACKEND: mitunet | yolo | cascade_swin | faster_rcnn | retinanet
WALL_BACKEND=mitunet
YOLO_WALL_WEIGHTS=https://huggingface.co/GreenMap/yolo11x-blueprint-wall-detector/resolve/main/yolo_walls_obb.pt
# Legacy MMDet wall weights — download from Google Drive into services/inference/models/
# https://drive.google.com/drive/folders/1MgW3Qo-8K4OrHi4ebvYd-81cTqQxwLgz
WALL_CASCADE_SWIN_WEIGHTS=models/cascade_swin_latest.pth
WALL_FASTER_RCNN_WEIGHTS=models/faster_rcnn_latest.pth
WALL_RETINANET_WEIGHTS=models/retinanet_latest.pth
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=floorplan-iculh/1

# Server-only (Next.js BFF / never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Backend on laptop mock OR RACE GPU station ──────────────────
# Laptop: RUN_MODE=mock DEVICE=cpu
# RACE (private virtual station): RUN_MODE=real DEVICE=cuda + worker
RUN_MODE=mock
DEVICE=cpu

# Prefer 127.0.0.1 — FastAPI is local/debug, not a public RACE API
API_HOST=127.0.0.1
API_PORT=8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ANNOTATIONS_DIR=./data/annotations
SOFTWARE_COMMIT=

# ── Training (services/training) — RACE GPU station only ────────
# Weights/datasets in AWS Storage; browser never calls RACE.
