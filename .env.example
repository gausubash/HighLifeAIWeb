# ── Frontend (apps/web) — laptop, local data only ───────────────
# Local Supabase (Docker). Do not point these at *.supabase.co if drawings must stay on this PC.
# Keys are filled by: npm run data:start
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Local-first floor-plan intelligence API (services/api). Not a cloud vision URL.
NEXT_PUBLIC_FLOOR_PLAN_API_URL=http://127.0.0.1:8001

# Local Inference API.
NEXT_PUBLIC_INFERENCE_API_URL=auto
USE_LAYOUT_DETECTOR=false
YOLO_WEIGHTS=
USE_ROOM_DETECTOR=false
YOLO_ROOM_WEIGHTS=
# Detect walls: MitUNet (`wall:mitunet`) or ArchVision Roboflow (`wall:roboflow`).
WALL_BACKEND=mitunet
YOLO_WALL_WEIGHTS=https://huggingface.co/GreenMap/yolo11x-blueprint-wall-detector/resolve/main/yolo_walls_obb.pt
# Legacy MMDet wall weights — download from Google Drive into services/inference/models/
# https://drive.google.com/drive/folders/1MgW3Qo-8K4OrHi4ebvYd-81cTqQxwLgz
WALL_CASCADE_SWIN_WEIGHTS=models/cascade_swin_latest.pth
WALL_FASTER_RCNN_WEIGHTS=models/faster_rcnn_latest.pth
WALL_RETINANET_WEIGHTS=models/retinanet_latest.pth
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=floorplan-iculh/1
ROBOFLOW_WALL_MODEL_ID=archvision_wall_detect/1
ROBOFLOW_ROOM_MODEL_ID=floorplan-9fxye/1

# Server-only (Next.js BFF / never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ── Backend on laptop mock OR RACE GPU station ──────────────────
# Laptop: RUN_MODE=mock DEVICE=cpu
# RACE (private virtual station): RUN_MODE=real DEVICE=cuda + worker
RUN_MODE=mock
DEVICE=cpu

# Prefer 127.0.0.1 — FastAPI is local/debug, not a public RACE API
API_HOST=127.0.0.1
API_PORT=8000

# Local Supabase (same machine). Written by npm run data:start.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

ANNOTATIONS_DIR=./data/annotations
SOFTWARE_COMMIT=

# ── Training (services/training) — RACE GPU station only ────────
# Weights/datasets in AWS Storage; browser never calls RACE.

# ── RACE remote SSH (repo-root .env — used by scripts/race-remote-setup.ps1) ──
# RACE_HOST=race
# RACE_HOST_NAME=ec2-xx-xx-xx-xx.ap-southeast-2.compute.amazonaws.com
# RACE_USER=ec2-user
# RACE_KEY=C:/Users/you/.ssh/your-key.pem
# RACE_REPO=~/HighLifeAIWeb
# Cloud Supabase service role for the RACE worker (never in browser):
# SUPABASE_SERVICE_ROLE_KEY=your-cloud-service-role-key
