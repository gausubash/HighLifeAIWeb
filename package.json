{
  "name": "highlife-ai-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @highlife/web",
    "dev:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "race:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/race-remote-setup.ps1",
    "race:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/race-tunnel.ps1",
    "race:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/race-check.ps1",
    "race:fix-gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/race-fix-gpu.ps1",
    "data:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-data.ps1",
    "data:stop": "npx supabase stop",
    "data:status": "npx supabase status",
    "data:env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/write-local-env.ps1",
    "build": "npm run build -w @highlife/web",
    "lint": "npm run lint -w @highlife/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @highlife/web",
    "test:inference": "cd services/inference && python -m pytest tests/ -v",
    "test:api": "cd services/api && python -m pytest tests/ -v"
  },
  "engines": {
    "node": ">=20"
  }
}
